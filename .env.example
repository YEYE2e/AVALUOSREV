# Copiar a .env. Usar una carpeta absoluta privada, sin acceso de otros usuarios.
AVALUOS_STORAGE_ROOT=C:/ruta/privada/expedientes
# Ejecutable de confianza compatible con el CLI de omp. No se recibe desde la web.
AVALUOS_AGENT_EXECUTABLE=omp
AVALUOS_AGENT_MODEL=openai-codex/gpt-6.1-terra
AVALUOS_AGENT_EFFORT=medium
AVALUOS_LOCAL_PILOT=0
