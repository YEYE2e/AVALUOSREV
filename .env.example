# Copiar a .env. Usar una carpeta absoluta privada, sin acceso de otros usuarios.
# Windows: C:/ruta/privada/expedientes  |  macOS/Linux: /Users/tuusuario/avaluos-data
AVALUOS_STORAGE_ROOT=C:/ruta/privada/expedientes
# Ejecutable de confianza compatible con el CLI de omp. No se recibe desde la web.
AVALUOS_AGENT_EXECUTABLE=omp
AVALUOS_AGENT_MODEL=openai-codex/gpt-6.1-terra
AVALUOS_AGENT_EFFORT=medium
# Verificador independiente (opcional; si se omiten, usa el mismo modelo/esfuerzo).
AVALUOS_ENABLE_VERIFIER=1
AVALUOS_VERIFIER_MODEL=
AVALUOS_VERIFIER_EFFORT=
# Motor de marcado Excel: auto (Excel COM en Windows, openpyxl en macOS/Linux), com u openpyxl.
AVALUOS_EXCEL_ENGINE=auto
# Límites de ejecución por etapa del agente (segundos y costo máximo USD).
# Para libros grandes con varios respaldos se recomiendan >= 420 s y >= 2.00 USD.
AVALUOS_AGENT_MAX_TIME=420
AVALUOS_AGENT_MAX_COST=2.00
AVALUOS_LOCAL_PILOT=0
